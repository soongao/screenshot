{
  "manifest_version": 3,
  "name": "Screenshot Browser Scroll Bridge",
  "description": "Bridge Chromium pages to the Electron screenshot app for precise scroll container detection.",
  "version": "0.1.0",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:32123/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
